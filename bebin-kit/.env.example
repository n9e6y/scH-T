# LLM (OpenAI-compatible provider). Run `make check-llm` to fill the model names
LLM_ENABLED=true
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_ASSISTANT=
LLM_MODEL_FAST=
EMBEDDINGS_PROVIDER=off
EMBEDDINGS_MODEL=
EMBEDDINGS_DIM=256
# App
CATALOG_DB_PATH=api/data/catalog.db
APP_DB_PATH=api/data/app.db
VECTORS_DIR=api/data/vectors
CORS_ORIGINS=http://localhost:3000
SIMULATOR_ENABLED=true
SIMULATOR_SPEED=1.0
NO_ANSWER_TIMEOUT_S=90
DEMO_DIRECTOR_ENABLED=true
# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
